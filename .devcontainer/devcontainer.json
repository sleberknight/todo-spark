{
	"name": "todo-spark",
	// The default Codespaces image already bundles SDKMAN, so no separate Java feature
	// is declared here - but the JDK it caches is a Microsoft build, not the Zulu build
	// .sdkmanrc pins. etc/run.sh's own "sdk env" call will use SDKMAN to fetch that
	// exact pinned build on first run regardless of what's already cached; that's a
	// deliberate one-time tradeoff rather than a second place to keep a Java version
	// in sync with .sdkmanrc.
	"image": "mcr.microsoft.com/devcontainers/universal:2",
	"postCreateCommand": "etc/install-spark-core.sh",
	"forwardPorts": [4567],
	"portsAttributes": {
		"4567": {
			"label": "todo-spark"
		}
	}
}
