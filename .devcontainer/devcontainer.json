{
	"name": "todo-spark",
	// The default Codespaces image already bundles SDKMAN and cached JDKs (including
	// Java 25), which lines up with what .sdkmanrc and etc/run.sh already expect - no
	// need to declare a separate Java feature/version here.
	"image": "mcr.microsoft.com/devcontainers/universal:2",
	"postCreateCommand": "etc/install-spark-core.sh",
	"forwardPorts": [4567],
	"portsAttributes": {
		"4567": {
			"label": "todo-spark"
		}
	}
}
